{
  "title": "HHKB-related mappings",
  "rules": [
    {
      "description": "Eisuu ↦ backspace",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "japanese_eisuu"
          },
          "to": [
            {
              "key_code": "delete_or_backspace"
            }
          ]
        }
      ]
    },
    {
      "description": "Kana ↦ return_or_enter",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "japanese_kana"
          },
          "to": [
            {
              "key_code": "return_or_enter"
            }
          ]
        }
      ]
    },
    {
      "description": "Shift + Eisuu ↦ option + backspace",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "japanese_eisuu",
            "modifiers": {
              "mandatory": [
                "shift"
              ]
            }
          },
          "to": [
            {
              "key_code": "delete_or_backspace",
              "modifiers": [
                "left_option"
              ]
            }
          ]
        }
      ]
    },
    {
      "description": "Shift + Kana ↦ Shift + return_or_enter",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "japanese_kana",
            "modifiers": {
              "mandatory": [
                "shift"
              ]
            }
          },
          "to": [
            {
              "key_code": "return_or_enter",
              "modifiers": [
                "shift"
              ]
            }
          ]
        }
      ]
    },
    {
      "description": "hhkb/caps ↦ ctrl",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "caps_lock"
          },
          "to": [
            {
              "key_code": "left_control"
            }
          ]
        }
      ]
    },
    {
      "description": "yen ➡️ emoji",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "international3"
          },
          "to": [
            {
              "key_code": "comma",
              "modifiers": [
                "left_control"
              ]
            }
          ]
        }
      ]
    },
    {
      "description": "international1 ➡️ search arc",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "international1"
          },
          "to": [
            {
              "key_code": "page_up",
              "modifiers": [
                "left_control"
              ]
            }
          ]
        }
      ]
    },
    {
      "description": "Shift + international1 ➡️ floating notes",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "international1",
            "modifiers": {
              "mandatory": [
                "shift"
              ]
            }
          },
          "to": [
            {
              "key_code": "page_down",
              "modifiers": [
                "left_control"
              ]
            }
          ]
        }
      ]
    },
    {
      "description": "pause ➡️ play_or_pause",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "pause"
          },
          "to": [
            {
              "key_code": "play_or_pause"
            }
          ]
        }
      ]
    },
    {
      "description": "eject ➡️ fastforward",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "eject"
          },
          "to": [
            {
              "key_code": "fastforward"
            }
          ]
        }
      ]
    }
  ]
}
